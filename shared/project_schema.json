{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Saga Project Schema",
  "type": "object",
  "required": ["name", "version", "start_scene", "navigation_mode", "scenes", "assets"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "start_scene": { "type": "string" },
    "navigation_mode": {
      "type": "string",
      "enum": ["pathfinding", "first_person"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "description": { "type": "string" },
        "license": { "type": "string" }
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "background", "hotspots"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "background": { "type": "string" },
          "size": {
            "type": "object",
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "required": ["width", "height"]
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string", "enum": ["background","sprite","tilemap","parallax"] },
                "source": { "type": "string" },
                "z": { "type": "integer" },
                "visible": { "type": "boolean" }
              },
              "additionalProperties": true
            }
          },
          "hotspots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "shape", "action"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "tags": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "shape": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": { "type": "string", "enum": ["rect","poly","circle"] },
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": { "type": "number" },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "radius": { "type": "number" }
                  },
                  "additionalProperties": false
                },
                "action": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string" },
                    "params": { "type": "object" }
                  },
                  "additionalProperties": true
                },
                "visible": { "type": "boolean" },
                "enabled": { "type": "boolean" },
                "z": { "type": "integer" }
              },
              "additionalProperties": true
            }
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id","type","sprite"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "sprite": { "type": "string" },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  }
                },
                "properties": { "type": "object" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "assets": {
      "type": "object",
      "required": ["sprites","audio","fonts", "items"],
      "properties": {
        "sprites": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "frame_size": {
                "type": "object",
                "properties": {
                  "width": { "type": "integer" },
                  "height": { "type": "integer" }
                }
              },
              "tags": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "type": { "type": "string", "enum": ["music","sfx"] },
              "volume": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": true
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "size": { "type": "integer" }
            },
            "additionalProperties": true
          }
        },
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["name", "description", "path"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "path": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "raw": {
          "type": "object",
          "description": "arquivos arbitrários referenciáveis"
        }
      },
      "additionalProperties": true
    },
    "dialogs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["start_node"],
        "properties": {
          "start_node": { "type": "string" },
          "nodes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string", "enum": ["line", "choice"] },
                "character": { "type": "string" },
                "text": { "type": "string" },
                "next": { "type": ["string", "null"] },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["text", "next"],
                    "properties": {
                      "text": { "type": "string" },
                      "next": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
